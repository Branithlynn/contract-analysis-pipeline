{
  "name": "contract-analysis-pipeline",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/shared",
    "services/api",
    "services/worker",
    "apps/web"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @nexus/web",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && npm run typecheck -w @nexus/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "predev": "tsc -b",
    "dev": "node --env-file-if-exists=.env node_modules/concurrently/dist/bin/index.js -n tsc,api,worker,web \"tsc -b --watch --preserveWatchOutput\" \"node --watch-path=services/api/dist --watch-path=packages/shared/dist services/api/dist/index.js\" \"node --watch-path=services/worker/dist --watch-path=packages/shared/dist services/worker/dist/index.js\" \"npm run dev -w @nexus/web\"",
    "docker:up": "docker compose up --build -d",
    "docker:up:ollama": "docker compose --profile ollama up --build -d",
    "docker:down": "docker compose --profile \"*\" down",
    "docker:reset": "docker compose --profile \"*\" down -v",
    "test-files": "tsx scripts/make-test-files.ts",
    "samples": "tsx scripts/make-samples.ts",
    "preeval": "tsc -b",
    "eval": "tsx evals/run.ts",
    "preeval:rescore": "tsc -b",
    "eval:rescore": "tsx evals/rescore.ts",
    "prellm-smoke": "tsc -b",
    "llm-smoke": "tsx scripts/llm-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "prettier": "~3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
