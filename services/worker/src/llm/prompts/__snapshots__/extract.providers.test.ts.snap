e"],"additionalProperties":false,"description":"Length of the initial term in months"},"renewal_term_months":{"type":"object","properties":{"value":{"type":["number","null"]},"quote":{"type":"string","description":"Exact text copied from the document that supports the value, or an empty string if not found"},"confidence":{"type":"string","enum":["high","medium","low"]}},"required":["value","quote","confidence"],"additionalProperties":false,"description":"Length of each renewal term in months"},"termination_notice_days":{"type":"object","properties":{"value":{"type":["number","null"]},"quote":{"type":"string","description":"Exact text copied from the document that supports the value, or an empty string if not found"},"confidence":{"type":"string","enum":["high","medium","low"]}},"required":["value","quote","confidence"],"additionalProperties":false,"description":"Days of notice required to end the agreement as a whole or stop it from renewing. Never a cure or remedy period, and not a termination for convenience right that only one party has"},"auto_renewal":{"type":"object","properties":{"value":{"type":["boolean","null"]},"quote":{"type":"string","description":"Exact text copied from the document that supports the value, or an empty string if not found"},"confidence":{"type":"string","enum":["high","medium","low"]}},"required":["value","quote","confidence"],"additionalProperties":false,"description":"Whether the agreement renews automatically"},"total_contract_value":{"type":"object","properties":{"value":{"anyOf":[{"type":"object","properties":{"amount":{"type":"number"},"currency":{"type":"string","description":"ISO 4217 currency code, e.g. USD, EUR"}},"required":["amount","currency"],"additionalProperties":false},{"type":"null"}]},"quote":{"type":"string","description":"Exact text copied from the document that supports the value, or an empty string if not found"},"confidence":{"type":"string","enum":["high","medium","low"]}},"required":["value","quote","confidenc