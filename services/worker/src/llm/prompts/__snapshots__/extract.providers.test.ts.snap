ed":["value","quote","confidence"],"additionalProperties":false,"description":"Jurisdiction whose law governs the agreement"},"liability_cap":{"type":"object","properties":{"value":{"type":["string","null"]},"quote":{"type":"string","description":"Exact text copied from the document that supports the value, or an empty string if not found"},"confidence":{"type":"string","enum":["high","medium","low"]}},"required":["value","quote","confidence"],"additionalProperties":false,"description":"Limit on liability in the document's own words, for example 'fees paid in the 12 months before the claim' or 'USD 50,000'. Do not calculate it."},"effective_date":{"type":"object","properties":{"value":{"type":["string","null"]},"quote":{"type":"string","description":"Exact text copied from the document that supports the value, or an empty string if not found"},"confidence":{"type":"string","enum":["high","medium","low"]}},"required":["value","quote","confidence"],"additionalProperties":false,"description":"Date the agreement starts or takes effect, formatted YYYY-MM-DD. A separate signing date is not the effective date"},"expiration_date":{"type":"object","properties":{"value":{"type":["string","null"]},"quote":{"type":"string","description":"Exact text copied from the document that supports the value, or an empty string if not found"},"confidence":{"type":"string","enum":["high","medium","low"]}},"required":["value","quote","confidence"],"additionalProperties":false,"description":"Date the initial term ends, formatted YYYY-MM-DD"},"initial_term_months":{"type":"object","properties":{"value":{"type":["number","null"]},"quote":{"type":"string","description":"Exact text copied from the document that supports the value, or an empty string if not found"},"confidence":{"type":"string","enum":["high","medium","low"]}},"required":["value","quote","confidence"],"additionalProperties":false,"description":"Length of the initial term in months"},"renewal_term_months":{"type":"object","properties":{"value":{"type":["number","null"]},"quote":{"type":"string","description":"Exact text copied from the document that supports the value, or an empty string if not found"},"confidence":{"type":"string","enum":["high","medium","low"]}},"required":["value","quote","confidence"],"additionalProperties":false,"description":"Length of each renewal term in months"},"termination_notice_days":{"type":"object","properties":{"value":{"type":["number","null"]},"quote":{"type":"string","description":"Exact text copied from the document that supports the value, or an empty string if not found"},"confidence":{"type":"string","enum":["high","medium","low"]}},"required":["value","quote","confidence"],"additionalProperties":false,"description":"Days of notice required to terminate the agreement or stop it from renewing. Never a cure or remedy period"},"auto_renewal":{"type":"object","properties":{"value":{"type":["boolean","null"]},"quote":{"type":"string","description":"Exact text copied from the document that supports the value, or an empty string if not found"},"confidence":{"type":"string","enum":["high","medium","low"]}},"required":["value","quote","confidence"],"additionalProperties":false,"description":"Whether the agreement renews automatically"},"total_contract_value":{"type":"object","properties":{"value":{"anyOf":[{"type":"object","properties":{"amount":{"type":"number"},"currency":{"type":"string","description":"ISO 4217 currency code, e.g. USD, EUR"}},"required":["amount","currency"],"additionalProperties":false},{"type":"null"}]},"quote":{"type":"string","description":"Exact text copied from the document that supports the value, or an empty string if not found"},"confidence":{"type":"string","enum":["high","medium","low"]}},"required":["value","quote","confidence"],"additionalProperties":false,"description":"Total value of the agreement"},"risk_clauses":{"type":"array","items":{"type":"object","properties":{"category":{"type":"string","enum":["auto_renewal","uncapped_liability","broad_indemnification","unilateral_price_increase","termination_for_convenience_vendor_only","exclusivity","ip_assignment","data_protection_gap","penalties_liquidated_damages","unfavorable_payment_terms","foreign_governing_law","other"]},"severity":{"type":"string","enum":["low","medium","high"]},"title":{"type":"string"},"explanation":{"type":"string","description":"One sentence in your own words on why this clause matters to Nexus Corp. Do not repeat the quote."},"quote":{"type":"string","description":"Exact text copied from the document"}},"required":["category","severity","title","explanation","quote"],"additionalProperties":false}},"summary":{"type":"string","description":"Plain summary of the document, max 80 words"}},"required":["document_type","vendor_name","customer_name","payment_terms","governing_law","liability_cap","effective_date","expiration_date","initial_term_months","renewal_term_months","termination_notice_days","auto_renewal","total_contract_value","risk_clauses","summary"],"additionalProperties":false}",
}
`;

