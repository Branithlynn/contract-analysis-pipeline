NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./data/uploads
REDIS_URL=redis://localhost:6379
MAX_UPLOAD_MB=20
MAX_FILES_PER_REQUEST=10
# LLM provider. Keep one block uncommented. The model always comes from LLM_MODEL, never from code.
# ollama: contracts stay on this machine, no key needed.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
# anthropic: needs ANTHROPIC_API_KEY below.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# openai: needs OPENAI_API_KEY below.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5-mini
# mock: canned extraction, for tests and demos without any model. Needs ALLOW_MOCK=true below.
# LLM_PROVIDER=mock
# LLM_PROVIDER / LLM_MODEL are the default. A model can also be picked per upload and per reanalysis,
# from what GET /api/models lists: installed ollama chat models, and these allowlists for the hosted
# providers (comma separated). A request cannot name a hosted model that is not listed here.
OPENAI_MODELS=gpt-5-mini
ANTHROPIC_MODELS=claude-sonnet-5-5
# Lets the mock provider be selected. For dev and ci, leave false anywhere real contracts go.
ALLOW_MOCK=false
# Embeddings for the search index, chosen separately from the LLM. ollama, openai (needs OPENAI_API_KEY)
# or mock (hashed vectors, for tests and demos without a model). Anthropic has no embeddings api.
EMBED_PROVIDER=ollama
# Blank means the provider's default: nomic-embed-text for ollama, text-embedding-3-small for openai.
# After changing it run `npm run index:backfill`, vectors of two models can't be compared.
EMBED_MODEL=
# Ollama only: layers of the embedding model on the gpu (options.num_gpu). 0 runs it on the cpu in system
# ram, so it stays loaded next to the chat model instead of the two being swapped. -1 lets ollama decide.
EMBED_OLLAMA_NUM_GPU=0
OLLAMA_URL=http://localhost:11434
# num_ctx of every chat call to ollama, extraction and ask alike, so the model is not reloaded between them.
# 10240 fits a full chunk at LLM_MAX_INPUT_CHARS=12000. The worker warns at startup when a chunk needs more.
OLLAMA_NUM_CTX=10240
# Only read by docker compose. Uncomment when ollama runs natively on the host instead of the compose ollama profile.
# DOCKER_OLLAMA_URL=http://host.docker.internal:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_MS=300000
# Only read by docker compose: how long docker waits for the worker to stop. Keep it above LLM_TIMEOUT_MS + 30s.
# WORKER_STOP_GRACE=6m
LLM_MAX_INPUT_CHARS=12000
# POST /api/ask: one limit for the whole answer, model calls and tool calls included.
ASK_TIMEOUT_MS=180000
# How many times the model may be called for one question (5 rounds of tools and the answer).
ASK_MAX_STEPS=6
# Ollama only: how long a question waits while the worker is extracting before it gets MODEL_BUSY.
ASK_BUSY_WAIT_MS=5000
# Which extraction prompt the worker uses: extract.v1, extract.v2 or extract.v3. Stored on every extraction.
PROMPT_VERSION=extract.v3
LLM_CHUNK_CONCURRENCY=1
# Hosted jobs (openai, anthropic) running at once. Ollama jobs always run one at a time.
WORKER_CONCURRENCY=2
JOB_ATTEMPTS=3
GROUNDING_REVIEW_THRESHOLD=0.8
