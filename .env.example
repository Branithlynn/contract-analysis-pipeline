NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./data/uploads
REDIS_URL=redis://localhost:6379
MAX_UPLOAD_MB=20
MAX_FILES_PER_REQUEST=10
# LLM provider. Keep one block uncommented. The model always comes from LLM_MODEL, never from code.
# ollama: contracts stay on this machine, no key needed.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
# anthropic: needs ANTHROPIC_API_KEY below.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# openai: needs OPENAI_API_KEY below.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5-mini
# mock: canned extraction, for tests and demos without any model.
# LLM_PROVIDER=mock
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_MS=300000
LLM_MAX_INPUT_CHARS=12000
LLM_CHUNK_CONCURRENCY=1
WORKER_CONCURRENCY=2
JOB_ATTEMPTS=3
GROUNDING_REVIEW_THRESHOLD=0.8
